# ============================================================
# SECRETS — never commit these
# ============================================================
.env
.env.local
.env.*.local
*.key
*.pem
secrets.toml
.streamlit/secrets.toml
credentials.json
service-account*.json

# detect-secrets baseline is safe to commit, but the audit file is not
.secrets.baseline.audit

