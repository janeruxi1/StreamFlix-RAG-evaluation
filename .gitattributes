# Normalize line endings across platforms.
#
# Without this, generated files (the corpus and golden set are written by
# src/corpus/build.py) get CRLF on Windows and LF elsewhere, so every
# regeneration on a different machine shows all 45 corpus files as
# modified with no actual content change. The corpus generators pin LF
# explicitly; this makes git agree.

* text=auto eol=lf

# Notebooks are JSON — diff as text, but never let a merge tool try to
# auto-resolve them; a merged .ipynb is usually corrupt.
*.ipynb text eol=lf merge=binary

# Binary assets — never touch these
*.png binary
*.jpg binary
*.npy binary
*.faiss binary
