# =====================================================================
# StreamFlix RAG — environment template
# =====================================================================
#
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is gitignored. This template is not, and must never contain a
# real credential. Every value below is a placeholder.
#
# Verify your setup without printing the key:
#
#     python -m src.llm.provider --check
#
# =====================================================================


# ---------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------
# Only the provider you actually use needs a key.
#
# Recommended: create a PROJECT-SCOPED key at platform.openai.com with a
# monthly spend cap, rather than a full-account key. If it ever leaks,
# the blast radius is one project and one capped budget.
OPENAI_API_KEY=sk-your-key-here

# Optional — only if you set LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here


# ---------------------------------------------------------------------
# Provider + models
# ---------------------------------------------------------------------
# openai | anthropic | ollama  (ollama runs locally and needs no key)
LLM_PROVIDER=openai

# The model under evaluation. Cheap on purpose — the point of the harness
# is to measure whether a small model is good enough, not to assume it.
GENERATION_MODEL=gpt-4o-mini

# The judge must be STRONGER than the generator. A model grading its own
# output family shares its blind spots, which inflates every score.
JUDGE_MODEL=gpt-4o

# Local embedding model — runs on CPU, no API cost, no key required.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Force an embedding backend. Leave unset to auto-select:
# sentence-transformers if installed, else the TF-IDF+SVD fallback.
# EMBEDDING_BACKEND=sentence_transformer


# ---------------------------------------------------------------------
# Cost controls
# ---------------------------------------------------------------------
# Hard ceiling on API calls per process run. A runaway loop over a
# 120-question golden set is the realistic way to burn a budget by
# accident, so the ceiling raises rather than warns.
MAX_LLM_CALLS_PER_RUN=2000

# Cache responses on disk, keyed by model + prompt + params. Re-running a
# notebook after a kernel restart then costs nothing.
ENABLE_LLM_CACHE=true
